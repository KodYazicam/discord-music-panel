# Server Configuration
PORT=4000
NODE_ENV=development

# JWT Secret (generate a strong random string)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# AES-256 key material for Discord bot tokens at rest (falls back to JWT_SECRET)
TOKEN_ENCRYPTION_KEY=change-this-token-encryption-key

# Database
DATABASE_PATH=./data/database.sqlite

# First registered panel user becomes admin (POST /api/auth/register).
# Do not commit a real password.

# Spotify API (optional - for Spotify support)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# yt-dlp (required for playback). Optional cookie file or raw cookie header.
YTDLP_PATH=yt-dlp
YOUTUBE_COOKIE=

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/app.log

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS Origins (comma separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:4000

# Frontend URL (for redirects)
FRONTEND_URL=http://localhost:3000

# Standalone bot (used by `docker compose --profile bot up`).
# Required only for the optional bot service; leave empty for panel-only setups.
DISCORD_TOKEN=
BOT_NAME=DockerMusicBot
BOT_PREFIX=!
