{
  "name": "discord-music-panel",
  "version": "1.0.0",
  "description": "Multi-instance Discord Music Bot Management Panel - Run multiple bots with different prefixes from a single dashboard",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "bot": "node src/bot/standalone.js",
    "build:frontend": "cd frontend && npm run build",
    "install:all": "npm install && cd frontend && npm install",
    "setup": "node src/scripts/setup.js"
  },
  "keywords": [
    "discord",
    "discord-bot",
    "music-bot",
    "discord-music-bot",
    "discord-js",
    "multi-bot",
    "bot-panel",
    "web-dashboard",
    "youtube",
    "spotify",
    "soundcloud",
    "music-player",
    "nodejs",
    "react",
    "expressjs"
  ],
    "author": {
    "name": "KodYazicam",
    "url": "https://github.com/KodYazicam"
  },
  "license": "MIT",
  "homepage": "https://github.com/KodYazicam/discord-music-panel#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KodYazicam/discord-music-panel.git"
  },
  "bugs": {
    "url": "https://github.com/KodYazicam/discord-music-panel/issues"
  },
  "dependencies": {
    "@discordjs/opus": "^0.9.0",
    "@discordjs/voice": "^0.16.1",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^9.2.2",
    "cors": "^2.8.5",
    "discord.js": "^14.14.1",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-session": "^1.17.3",
    "jsonwebtoken": "^9.0.2",
    "play-dl": "^1.9.7",
    "libsodium-wrappers": "^0.7.13",
    "socket.io": "^4.6.1",
    "uuid": "^9.0.0",
    "winston": "^3.11.0",
    "ytdl-core": "^4.11.5"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
