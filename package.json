{
  "name": "discord-music-panel",
  "version": "1.0.0",
  "description": "Multi-instance Discord Music Bot Management Panel - Run multiple bots with different prefixes from a single dashboard",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "bot": "node src/bot/standalone.js",
    "build:frontend": "cd frontend && npm run build",
    "install:all": "npm install && cd frontend && npm install",
    "setup": "node src/scripts/setup.js",
    "test": "node --test"
  },
  "keywords": [
    "discord",
    "discord-bot",
    "music-bot",
    "discord-music-bot",
    "discord-js",
    "multi-bot",
    "bot-panel",
    "web-dashboard",
    "youtube",
    "spotify",
    "soundcloud",
    "music-player",
    "nodejs",
    "react",
    "expressjs"
  ],
  "author": {
    "name": "KodYazicam",
    "url": "https://github.com/KodYazicam"
  },
  "license": "MIT",
  "homepage": "https://github.com/KodYazicam/discord-music-panel#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KodYazicam/discord-music-panel.git"
  },
  "bugs": {
    "url": "https://github.com/KodYazicam/discord-music-panel/issues"
  },
  "dependencies": {
    "@discordjs/opus": "^0.11.0",
    "@discordjs/voice": "^0.19.2",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.5",
    "discord.js": "^14.28.1",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "libsodium-wrappers": "^0.8.4",
    "socket.io": "^4.8.4",
    "uuid": "^14.0.3",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "overrides": {
    "tar": "^7.5.21",
    "minimatch": "^11.0.5"
  }
}
